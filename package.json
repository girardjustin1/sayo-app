{
  "name": "sayo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5340 --strictPort --host",
    "build": "tsc -b && vite build",
    "storybook": "storybook dev -p 6030 --no-open",
    "build-storybook": "storybook build --quiet",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "packageManager": "pnpm@9.1.0",
  "dependencies": {
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^1.71.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/react-vite": "^10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "storybook": "^10",
    "typescript": "^5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
